# SAYMON API
SAYMON_BASE_URL=http://localhost:8080
SAYMON_API_PREFIX=/node/api
SAYMON_LOGIN=
SAYMON_PASSWORD=
# После логина — GET с cookies (как ?url= в /apps/auth); пусто = пропустить
SAYMON_AUTH_REDIRECT_URL=

# Grouping (mirrors frontend defaults)
GROUP_BY_CLASS_NAMES=["Host","Router","Local Address"]
GROUP_BY_DEPTH=4

# Responsible-party macros
MACROS=["{{parent[class.id=30,3,24].properties[17. Ответственный]}}","{{parent[class.id=30,3,24].properties[20. Группа для уведомления администраторов систем]}}"]
MACRO_DEPTH=8

# Fetch limits (paginated; raise if web UI shows more incidents than worker)
FETCH_LIMIT=1000
HISTORY_LIMIT=5000
FETCH_PAGE_SIZE=500

# Background worker (alarm-manager-worker)
# В docker compose worker использует http://server:4800 автоматически
SERVER_URL=http://127.0.0.1:4800
WORKER_INTERVAL_SEC=60
INCIDENT_LINK_TEMPLATE={saymon_base_url}/saymon.local/apps/alarm-manager?incident={id}

# File cache (persists between container restarts; mount CACHE_DIR as a volume in Docker)
CACHE_ENABLED=true
# Docker:
CACHE_DIR=/var/cache/alarm-manager
# Local venv (if unset in .env, default is ~/.local/share/alarm-manager/cache):
# CACHE_DIR=
# TTL in seconds per data type (0 = never read from cache for that type)
CACHE_TTL_INCIDENTS_SEC=120
CACHE_TTL_OBJECTS_SEC=3600
CACHE_TTL_OBJECT_PATHS_SEC=3600
CACHE_TTL_STATE_LABELS_SEC=86400
CACHE_TTL_CLASS_IDS_SEC=86400

# Worker tickets (between runs: create / update / close groups)
# Docker (with volume alarm-manager-data):
TICKETS_FILE=/var/lib/alarm-manager/tickets.json
# Local venv — удалите строку TICKETS_FILE или укажите, например:
# TICKETS_FILE=~/.local/share/alarm-manager/tickets.json
# Handlers внешней тикет-системы (module:Class, через запятую; нужен --tickets)
# TICKET_HANDLERS=alarm_manager_server.worker.ticket_handlers:LoggingTicketHandler
# TICKET_HANDLERS=my_company.integrations:ServiceDeskHandler

# --- Jira plugin (auto-enabled when all required vars are set) ---
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_USER=bot@example.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=OPS
# JIRA_ISSUE_TYPE=Task
# JIRA_CLOSE_TRANSITION=Done

# --- Redmine plugin (auto-enabled when all required vars are set) ---
# REDMINE_BASE_URL=https://redmine.example.com
# REDMINE_API_KEY=
# REDMINE_PROJECT_ID=42
# REDMINE_TRACKER_ID=1
# REDMINE_STATUS_CLOSED_ID=5

# --- Freshdesk plugin (auto-enabled when all required vars are set) ---
# FRESHDESK_BASE_URL=https://your-domain.freshdesk.com
# FRESHDESK_API_KEY=
# FRESHDESK_REQUESTER_EMAIL=monitoring@example.com
# FRESHDESK_PRIORITY=2
# FRESHDESK_STATUS_OPEN=2
# FRESHDESK_STATUS_CLOSED=5

# --- ServiceNow plugin ---
# SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
# SERVICENOW_USER=api_user
# SERVICENOW_PASSWORD=
# или OAuth: SERVICENOW_OAUTH_TOKEN=
# SERVICENOW_TABLE=incident
# SERVICENOW_CALLER_ID=
# SERVICENOW_ASSIGNMENT_GROUP=
# SERVICENOW_IMPACT=2
# SERVICENOW_URGENCY=2
# SERVICENOW_CLOSE_STATE=7

# --- SimpleOne plugin ---
# SIMPLEONE_BASE_URL=https://sandbox.dev.simpleone.ru
# SIMPLEONE_API_TOKEN=
# SIMPLEONE_TABLE=itsm_incident
# SIMPLEONE_CALLER=sys_id вызывающего
# SIMPLEONE_SERVICE=
# SIMPLEONE_CONTACT_TYPE=email
# SIMPLEONE_CLOSE_STATE=

# --- Naumen / ITSM 365 plugin ---
# NAUMEN_BASE_URL=https://your-tenant.itsm365.com/sd
# NAUMEN_ACCESS_KEY=uuid из api.auth.getAccessKey('login') в консоли Naumen
# NAUMEN_META_CLASS=serviceCall$serviceCall
# NAUMEN_CLIENT=ou$...
# NAUMEN_CLIENT_EMPLOYEE=employee$...
# NAUMEN_AGREEMENT=agreement$...
# NAUMEN_SERVICE=slmService$...
# NAUMEN_OFFICE=ou$...
# NAUMEN_COMMENT_AUTHOR=employee$...
# NAUMEN_CLOSE_STATE=resolved
# NAUMEN_CLOSE_CODE=resolved

# --- ELMA365 plugin ---
# ELMA_BASE_URL=https://company.elma365.ru
# ELMA_API_TOKEN=токен из раздела Администрирование → API
# ELMA_NAMESPACE=service_desk
# ELMA_APP_CODE=incident
# ELMA_TITLE_FIELD=__name
# ELMA_DESCRIPTION_FIELD=description
# ELMA_CLOSE_STATUS=closed
# ELMA_CONTEXT_EXTRA={"priority":"high"}
# ELMA_AUTH_MODE=bearer

# --- Bitrix24 plugin (входящий webhook) ---
# BITRIX24_WEBHOOK_URL=https://portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx
# BITRIX24_RESPONSIBLE_ID=1
# BITRIX24_CREATED_BY=1
# BITRIX24_GROUP_ID=0
# BITRIX24_COMMENT_AUTHOR_ID=0
# BITRIX24_COMPLETE_ON_CLOSE=true

# Comment on SAYMON incidents after external ticket CREATE (needs SAYMON_* on worker)
TICKET_SAYMON_COMMENT_ENABLED=true
TICKET_SAYMON_COMMENT_TEMPLATE=Service Desk ({system}): {external_ref}
